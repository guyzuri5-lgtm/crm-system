# Copy to .env.local and fill in real values (.env.local is gitignored — never commit
# real secrets). See README.md for where each of these comes from.

# ── Supabase ────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API → service_role secret. Server-only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp (Meta Cloud API) ───────────────────────────────────────────
# Meta for Developers → your app → WhatsApp → API Setup.
# The official channel: no device, no QR, and the number cannot be banned for
# sending — but business-initiated messages must use a template Meta approved.
#
# Phone number ID — NOT the phone number itself. Shown on the API Setup page.
WHATSAPP_PHONE_NUMBER_ID=

# מזהה חשבון הוואטסאפ העסקי (WABA). נדרש רק לניהול תבניות מהדשבורד — סנכרון
# הסטטוס מ-Meta, יצירה ומחיקה. השליחה עצמה עוברת דרך WHATSAPP_PHONE_NUMBER_ID
# ואינה תלויה בו. נמצא ב-WhatsApp Manager, ליד שם החשבון.
WHATSAPP_WABA_ID=
# System User access token with whatsapp_business_messaging. Generate a
# PERMANENT one (Business Settings → System Users); the token shown on the API
# Setup page expires after 24 hours and is only good for a first smoke test.
WHATSAPP_ACCESS_TOKEN=
# App Secret (App Settings → Basic). Used to verify the HMAC signature Meta puts
# on every webhook. Without it the webhook route rejects everything — that is
# deliberate: an unsigned webhook is exactly what an attacker would send.
WHATSAPP_APP_SECRET=
# Any random string you invent yourself. Paste the SAME value into the "Verify
# token" field when you set the Callback URL in Meta's dashboard. Generate one:
#   openssl rand -hex 24
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Optional.
#   WHATSAPP_API_VERSION   — defaults to v25.0
#   WHATSAPP_COUNTRY_CODE  — defaults to 972. Turns a local number (0501234567)
#                            into a wa_id (972501234567).
WHATSAPP_API_VERSION=
WHATSAPP_COUNTRY_CODE=
# Seconds the daily cron may spend sending before it stops on its own. Default 45,
# which is safe on Vercel's Hobby plan (functions are killed at 60s there, whatever
# maxDuration says). On Pro you can raise this to 280 for ~6x more messages per run.
CRON_TIME_BUDGET_SECONDS=

# ── Gmail (Google Cloud OAuth2) ─────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Not read anywhere in this app's runtime code (we only ever use the stored refresh
# token, never a live authorize/exchange step) — harmless to leave blank. Only matters
# if you replace the OAuth Playground method below with your own callback route.
GOOGLE_REDIRECT_URI=
# Obtained once via `npm run auth:google`; does not expire under normal use.
# חשוב: הטוקן הזה משמש גם לשליחת מייל וגם ליומן, ולכן הוא חייב להיות מופק
# עם שני ה-scopes יחד — gmail.send *וגם* calendar. טוקן ישן שהופק עם
# gmail.send בלבד ימשיך לשלוח מיילים אבל יחזיר 403 מול היומן.
GOOGLE_REFRESH_TOKEN=
# The Gmail address these tokens belong to, and the display name recipients see.

# אופציונלי. רק אם אתם מעדיפים להשאיר את טוקן המייל כמו שהוא ולהפיק טוקן
# נפרד ליומן. אם מוגדר — הוא מקבל עדיפות על GOOGLE_REFRESH_TOKEN עבור היומן
# בלבד. ברוב המקרים עדיף להשאיר ריק ולהשתמש בטוקן אחד לשניהם.
GOOGLE_CALENDAR_REFRESH_TOKEN=

# ── מערכת זימון פגישות ──────────────────────────────────────────────────
# כתובת הבסיס הציבורית, לבניית קישור הביטול שנשלח במייל האישור.
# ריק = נגזר אוטומטית מ-VERCEL_PROJECT_PRODUCTION_URL בפרודקשן,
# ומ-http://localhost:3000 בפיתוח. הגדירו במפורש אם יש דומיין מותאם.
NEXT_PUBLIC_APP_URL=

# ── שאלון הצ'אקרות ──────────────────────────────────────────────────────
# הדומיין שבו יושב index.html, כדי לאפשר לו לשלוח לכאן (CORS).
# ריק או * = כל מקור. לדוגמה: https://guy-tsuri.co.il
QUIZ_ALLOWED_ORIGIN=
# אופציונלי. אם תגדירו אותו, השאלון חייב לשלוח את אותו ערך בכותרת
# X-Quiz-Secret (ראו CONFIG.WEBHOOK_SECRET ב-index.html).
# שימו לב: הערך גלוי בקוד המקור של הדף הציבורי — הוא מרתיע סורקים
# אוטומטיים, אבל אינו אבטחה אמיתית. ההגנה האמיתית היא הוולידציה בשרת.
QUIZ_WEBHOOK_SECRET=

# קישור קביעת הפגישה שמופיע ב-CTA של מייל הדוח שנשלח אחרי מילוי השאלון.
# מאז הוספת מערכת הזימון הפנימית אפשר להצביע כאן על /book/<slug> של המערכת
# עצמה (למשל https://<הדומיין>/book/intro) במקום על Calendly.
# ריק = ברירת המחדל שבקוד (אותו קישור שמופיע ב-CONFIG.CALENDLY_URL בשאלון).
QUIZ_CALENDLY_URL=

# ── Cron ────────────────────────────────────────────────────────────────
# Any random string — Vercel automatically sends it as `Authorization: Bearer
# <value>` when calling scheduled functions once this env var exists on the project.
# Generate one with: openssl rand -hex 24
CRON_SECRET=

# ── ניוזלטר ─────────────────────────────────────────────────────────────
# חותם את קישור ההסרה מרשימת התפוצה שבתחתית כל ניוזלטר. בלעדיו השליחה נכשלת
# בכוונה — מייל דיוור בלי הסרה עובדת הוא בעיה מול הנמענים ומול ספקי הדואר.
# חייב להיות אותו ערך בפיתוח ובפרודקשן: שינוי שלו הופך קישורים שכבר נשלחו
# ללא תקפים. צרו אחד עם: openssl rand -hex 32
NEWSLETTER_UNSUB_SECRET=

# ── שליחת מייל (Postmark) ───────────────────────────────────────────────
# החליף את Gmail ב-2.9.2026. שתי סיבות: טוקן OAuth של אפליקציה במצב Testing
# פג אצל גוגל כל 7 ימים ושבר את כל המיילים בשקט, ומכסת Gmail (~500 ליום)
# קטנה מרשימת התפוצה עצמה.
#
# הטוקן של השרת ב-Postmark: Servers → השרת שלך → API Tokens.
POSTMARK_SERVER_TOKEN=

# כתובת השולח. חייבת להיות על דומיין מאומת ב-Postmark.
# פורמט מלא עם שם תצוגה, למשל:  גיא צורי <guy@spiritualguy.co.il>
POSTMARK_FROM=

# לאן יגיעו תשובות של לקוחות. ריק = לכתובת השולח.
POSTMARK_REPLY_TO=

# שמות ה-Message Streams ב-Postmark. ברירות המחדל מתאימות לחשבון חדש:
# "outbound" נוצר אוטומטית, ואת ה-broadcast יוצרים ידנית (חובה לניוזלטר —
# Postmark דורש שכל שליחה המונית תעבור בזרם נפרד).
POSTMARK_TRANSACTIONAL_STREAM=outbound
POSTMARK_BROADCAST_STREAM=broadcast
