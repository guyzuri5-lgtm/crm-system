# Copy to .env.local and fill in real values (.env.local is gitignored — never commit
# real secrets). See README.md for where each of these comes from.

# ── Supabase ────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API → service_role secret. Server-only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── ManyChat ────────────────────────────────────────────────────────────
# ManyChat → Settings → API.
MANYCHAT_API_TOKEN=
# Any random string you invent yourself — set the same value as a custom header
# (X-Webhook-Secret) on the ManyChat "External Request" action. Generate one with:
#   openssl rand -hex 24
MANYCHAT_WEBHOOK_SECRET=
# flow_ns of the one-time "reply relay" Flow: a Flow in ManyChat with a single
# WhatsApp message step whose content is just the {{CRM Reply Text}} field tag. The
# custom field itself is created automatically (POST /fb/page/createCustomField) —
# only the Flow needs building by hand, since ManyChat has no flow-authoring API.
# Needed for in-window free-typed replies; see sendDynamicReply in src/lib/manychat.ts.
MANYCHAT_REPLY_FLOW_NS=

# ── Gmail (Google Cloud OAuth2) ─────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Not read anywhere in this app's runtime code (we only ever use the stored refresh
# token, never a live authorize/exchange step) — harmless to leave blank. Only matters
# if you replace the OAuth Playground method below with your own callback route.
GOOGLE_REDIRECT_URI=
# Obtained once via the manual OAuth flow in the README; does not expire under normal use.
GOOGLE_REFRESH_TOKEN=
# The Gmail address these tokens belong to, and the display name recipients see.
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=

# ── שאלון הצ'אקרות ──────────────────────────────────────────────────────
# הדומיין שבו יושב index.html, כדי לאפשר לו לשלוח לכאן (CORS).
# ריק או * = כל מקור. לדוגמה: https://guy-tsuri.co.il
QUIZ_ALLOWED_ORIGIN=
# אופציונלי. אם תגדירו אותו, השאלון חייב לשלוח את אותו ערך בכותרת
# X-Quiz-Secret (ראו CONFIG.WEBHOOK_SECRET ב-index.html).
# שימו לב: הערך גלוי בקוד המקור של הדף הציבורי — הוא מרתיע סורקים
# אוטומטיים, אבל אינו אבטחה אמיתית. ההגנה האמיתית היא הוולידציה בשרת.
QUIZ_WEBHOOK_SECRET=

# ── Cron ────────────────────────────────────────────────────────────────
# Any random string — Vercel automatically sends it as `Authorization: Bearer
# <value>` when calling scheduled functions once this env var exists on the project.
# Generate one with: openssl rand -hex 24
CRON_SECRET=
